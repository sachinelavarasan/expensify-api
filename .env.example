DB_HOST= # same Postgres host lendslog-api uses
DB_PORT=5432

DB_NAME='' # same DB as lendslog-api (exp_* tables live alongside lends tables)

DB_USER=postgres
DB_PASSWORD=''

PORT=8000

# Expensify custom JWT auth
EXPENSIFY_JWT_ACCESS_SECRET=
EXPENSIFY_JWT_REFRESH_SECRET=
EXPENSIFY_JWT_ACCESS_EXPIRY=7d
EXPENSIFY_JWT_REFRESH_EXPIRY=90d

# SMTP (nodemailer, OTP emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Expensify

# Cloudinary (profile image + transaction attachment storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Expo push notifications - generate at https://expo.dev/accounts/[account]/settings/access-tokens
EXPENSIFY_EXPO_PUSH_NOTIFICATION_ACCESS_TOKEN=

# Static token required by the cron caller (e.g. GitHub Actions) to hit /crons routes
CRON_SECRET_TOKEN=

# Static token for the /notifications/test-send route (test/dev use only)
NOTIFICATION_TEST_TOKEN=

# Static token required to call GET /backup/export?userId=... (admin-only, Postman/manual use)
BACKUP_ADMIN_TOKEN=

DEBUG=